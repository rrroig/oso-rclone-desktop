#!/usr/bin/env python3
"""Launcher for OSO Rclone Desktop."""
import os
import sys

_here = os.path.dirname(os.path.dirname(os.path.abspath(os.path.realpath(__file__))))
if os.path.isdir(os.path.join(_here, "oso_rclone_desktop")):
    sys.path.insert(0, _here)

from oso_rclone_desktop.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
